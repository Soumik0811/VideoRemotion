        "text": "It's a promise."
      },
      {
        "start": 41.474,
        "end": 45.277,
        "text": "Because Starbucks still owes someone twenty dollars' worth of coffee."
      },
      {
        "start": 45.507,
        "end": 48.55,
        "text": "It's a debt wearing a gift card's clothing."
      },
      {
        "start": 49.45,
        "end": 52.972,
        "text": "Now, the friend visits Starbucks and spends fourteen dollars."
      },
      {
        "start": 53.202,
        "end": 55.55,
        "text": "Six dollars remain on the card."
      },
      {
        "start": 56.45,
        "end": 57.318,
        "text": "Weeks pass."
